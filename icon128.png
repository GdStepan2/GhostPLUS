/* Preserve only platform-issued badges; do not create verification marks. */
.gp-enabled :is(.post-name,.prof-name,.comment-author,.comment-name,.gs-reposter-name,.chat-name,.contact-name,.message-author,.chat-title) > .user-badges { order:2 !important; display:inline-flex !important; flex:0 0 auto !important; vertical-align:middle; margin-left:5px !important; margin-right:0 !important; overflow:visible !important; opacity:1; }
.gp-enabled :is(.post-name,.prof-name,.chat-name,.contact-name,.message-author,.chat-title) { overflow:visible !important; flex-wrap:wrap; }
.gp-enabled .ub-verified { display:inline-grid !important; place-items:center; flex:0 0 14px; width:14px; height:14px; vertical-align:middle; }
.gp-enabled :is(.chat-name,.contact-name,.message-author,.chat-title) { display:inline-flex; align-items:center; gap:4px; }
